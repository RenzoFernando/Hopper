{
  "manifest_version": 3,
  "name": "Hopper — Envío rápido",
  "version": "1.1.0",
  "description": "Envía texto, enlaces y archivos a tu espacio privado de Hopper desde cualquier pestaña.",
  "permissions": [
    "tabs",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://hopper-transfer.pages.dev/*"
  ],
  "action": {
    "default_title": "Hopper — Envío rápido",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hopper-transfer.pages.dev/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
